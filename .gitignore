# --------------------------------------------------
# Tauri / webview
# --------------------------------------------------
# These are files and directories generated by the
# Tauri framework.
# --------------------------------------------------
node_modules/
.svelte-kit/
src-tauri/out/
src-tauri/target/
src-tauri/build/
src-tauri/gen/schemas/

# --------------------------------------------------
# Tooling / cache
# --------------------------------------------------
# These are cache and temporary files created by
# various development tools.
# --------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
htmlcov/
.coverage
.coverage.*

# --------------------------------------------------
# Environment / secrets
# --------------------------------------------------
# these files contain sensitive information and
# should not be committed to the repository.
# --------------------------------------------------
.env
.env.*
*.pem

# --------------------------------------------------
# Scratch / workspace temp
# --------------------------------------------------
# These are temporary files created during
# development and build processes.
# --------------------------------------------------
scratch/
PROGRESS.md

# --------------------------------------------------
# Editor / IDE
# --------------------------------------------------
# These are files and directories created by
# various code editors and IDEs.
# --------------------------------------------------
.vscode/
.idea/
.jetbrains/
.vim/

# --------------------------------------------------
# Logging
# --------------------------------------------------
# These are log files generated by the application.
# --------------------------------------------------
logs/
*.log
*.log*
*.stderr
*.stderr*
*.stdout
*.stdout*

# --------------------------------------------------
# Whitelist
# --------------------------------------------------
# These are files and directories that are explicitly
# allowed to be committed to the repository, even if
# they would normally be ignored by other rules.
# --------------------------------------------------
!logs/.gitkeep