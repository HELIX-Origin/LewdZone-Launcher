# --------------------------------------------------
# Tauri / webview
# --------------------------------------------------
# These are files and directories generated by the
# Tauri framework.
# --------------------------------------------------
node_modules/
.svelte-kit/
dist/*
src-tauri/out/
src-tauri/target/
src-tauri/build/
src-tauri/gen/schemas/

# --------------------------------------------------
# Tooling / cache
# --------------------------------------------------
# These are cache and temporary files created by
# various development tools.
# --------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
htmlcov/
.coverage
.coverage.*

# --------------------------------------------------
# Node
# --------------------------------------------------
# Node.js dependencies and build artifacts
# --------------------------------------------------
node_modules/
dist/
build/
*.tsbuildinfo

# --------------------------------------------------
# Environment / secrets & Local DB
# --------------------------------------------------
# these files contain sensitive information and
# should not be committed to the repository.
# --------------------------------------------------
data/
.env
*.pem
*.db
*.db-*
*.sqlite
*.sqlite3
cookies.txt
cookies.json
data-cookies.txt
*.cookies.txt

# --------------------------------------------------
# Scratch / workspace temp
# --------------------------------------------------
# These are temporary files created during
# development and build processes.
# --------------------------------------------------
scratch/
backups/

# --------------------------------------------------
# Editor / IDE
# --------------------------------------------------
# These are files and directories created by
# various code editors and IDEs.
# --------------------------------------------------
.vscode/
.idea/
.jetbrains/
.vim/

# --------------------------------------------------
# Logging
# --------------------------------------------------
# These are log files generated by the application.
# --------------------------------------------------
logs/
*.log
*.log*
*.stderr
*.stderr*
*.stdout
*.stdout*

# --------------------------------------------------
# Lock Files
# --------------------------------------------------
# These are lock files generated by package managers
# and other tools to ensure consistent dependency
# versions and prevent concurrent modifications.
# --------------------------------------------------
*.lock
*-lock.json
*-lock.yaml

# --------------------------------------------------
# Miscellaneous
# --------------------------------------------------
# These are miscellaneous files that do not fit
# into other categories.
# --------------------------------------------------
*.tmp
*.temp
*.cache
*.bak
*.old
*.swp
*.pid
*.seed
*.pid.lock
*.seed.lock
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# --------------------------------------------------
# Whitelist
# --------------------------------------------------
# Explicitly allowed files and directories
# --------------------------------------------------
!dist/README.md
!logs/README.md
!scratch/README.md
!backups/README.md