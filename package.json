{
  "name": "lewdzone",
  "version": "0.3.0",
  "description": "LewdZone Launcher - cross-platform desktop game launcher",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "tauri:dev": "tauri dev",
    "build": "vite build",
    "build:log": "node scripts/build-with-log.mjs npm run build",
    "check:log": "node scripts/build-with-log.mjs npm run check",
    "test:log": "node scripts/build-with-log.mjs npm run test",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "build:installer": "node scripts/build-installer.mjs",
    "installer:build": "node scripts/build-installer.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "jsdom": "^30.1.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.8.57": true
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}
